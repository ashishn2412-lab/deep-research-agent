{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Runtime types come from the generated worker-configuration.d.ts, which
    // `wrangler types` produces from wrangler.jsonc. Re-run `npm run cf-typegen`
    // after changing bindings.
    "types": ["node", "vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // `@callable()` uses TC39 standard decorators, which are the default in
    // TS 5 with an ES2022 target. `experimentalDecorators` must stay off.
    "verbatimModuleSyntax": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src", "vite.config.ts", "worker-configuration.d.ts"]
}
